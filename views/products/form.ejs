<%- include('../partials/header') %>

<div class="card" style="max-width:600px">
    <div class="card-header">
        <h3><%= title %></h3>
        <a href="/products" class="btn btn-outline btn-sm">Quay lại</a>
    </div>
    <div class="card-body">
        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/products/<%= product && product.id ? 'edit/' + product.id : 'add' %>">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Mã sản phẩm *</label>
                    <input type="text" name="code" class="form-control" value="<%= product ? product.code : '' %>" required placeholder="VD: SP001">
                </div>
                <div class="form-group">
                    <label class="form-label">Tên sản phẩm *</label>
                    <input type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" required placeholder="Nhập tên sản phẩm">
                </div>
            </div>
            <div class="form-row">
                <% if (!product || !product.id) { %>
                <div class="form-group">
                    <label class="form-label">Số lượng ban đầu</label>
                    <input type="number" name="stock" class="form-control" value="<%= product ? product.stock : 0 %>" min="0" placeholder="0">
                </div>
                <% } %>
                <div class="form-group">
                    <label class="form-label">Giá (VNĐ) *</label>
                    <input type="number" name="price" class="form-control" value="<%= product ? product.price : '' %>" min="0" step="1000" required placeholder="0">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Loại sản phẩm</label>
                <input type="text" name="category" class="form-control" value="<%= product ? product.category : '' %>" placeholder="VD: Điện tử, Thực phẩm...">
            </div>
            <div style="display:flex;gap:10px;margin-top:4px">
                <button type="submit" class="btn btn-primary"><%= product && product.id ? 'Cập nhật' : 'Thêm mới' %></button>
                <a href="/products" class="btn btn-outline">Hủy</a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
