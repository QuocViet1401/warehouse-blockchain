<%- include('partials/header') %>

<!-- Stat cards -->
<div class="stats-grid">
    <div class="stat-card blue">
        <div class="stat-label">Tổng sản phẩm</div>
        <div class="stat-value"><%= stats.total_products %></div>
    </div>
    <div class="stat-card green">
        <div class="stat-label">Tổng nhập kho</div>
        <div class="stat-value"><%= stats.total_import.toLocaleString() %></div>
    </div>
    <div class="stat-card red">
        <div class="stat-label">Tổng xuất kho</div>
        <div class="stat-value"><%= stats.total_export.toLocaleString() %></div>
    </div>
    <div class="stat-card yellow">
        <div class="stat-label">Tồn kho hiện tại</div>
        <div class="stat-value"><%= stats.total_stock.toLocaleString() %></div>
    </div>
</div>

<% if (low_stock.length > 0) { %>
<div class="alert alert-warning">
    Cảnh báo: Có <strong><%= low_stock.length %></strong> sản phẩm sắp hết hàng (tồn kho &lt;= 10).
    <a href="/inventory" style="color:inherit;font-weight:600;margin-left:8px;">Xem ngay →</a>
</div>
<% } %>

<!-- Hàng 1: Biểu đồ xu hướng + Blockchain panel -->
<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px">

    <!-- Biểu đồ nhập/xuất 7 ngày -->
    <div class="card">
        <div class="card-header">
            <h3>Hoạt động 7 ngày gần nhất</h3>
            <span style="font-size:12px;color:#9ca3af">Số lượng nhập/xuất theo ngày</span>
        </div>
        <div class="card-body" style="padding-bottom:16px">
            <canvas id="trendChart" height="110"></canvas>
        </div>
    </div>

    <!-- Blockchain info panel -->
    <div class="card">
        <div class="card-header">
            <h3>Trạng thái Blockchain</h3>
            <% if (blockchainStats.chainValid) { %>
            <span style="color:#16a34a;font-size:12px;font-weight:700">✓ Hợp lệ</span>
            <% } else { %>
            <span style="color:#dc2626;font-size:12px;font-weight:700">✗ Bị xâm phạm!</span>
            <% } %>
        </div>
        <div class="card-body" style="padding:0">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid #f3f4f6">
                <div style="padding:14px 16px;border-right:1px solid #f3f4f6;text-align:center">
                    <div style="font-size:28px;font-weight:800;color:#4f46e5"><%= blockchainStats.total_blocks %></div>
                    <div style="font-size:11px;color:#9ca3af;margin-top:2px">Tổng số khối</div>
                </div>
                <div style="padding:14px 16px;text-align:center">
                    <div style="font-size:28px;font-weight:800;color:#16a34a"><%= blockchainStats.signed_blocks %></div>
                    <div style="font-size:11px;color:#9ca3af;margin-top:2px">Đã ký số</div>
                </div>
            </div>
            <% if (blockchainStats.total_blocks > 0) { %>
            <div style="padding:10px 0;border-bottom:1px solid #f3f4f6">
                <div style="padding:0 16px 6px;font-size:11px;color:#9ca3af;font-weight:600;text-transform:uppercase;letter-spacing:.5px">Độ phủ chữ ký số</div>
                <div style="padding:0 16px;display:flex;align-items:center;gap:10px">
                    <div style="flex:1;background:#f3f4f6;border-radius:99px;height:8px;overflow:hidden">
                        <div style="height:100%;background:#16a34a;border-radius:99px;width:<%= Math.round(blockchainStats.signed_blocks/blockchainStats.total_blocks*100) %>%"></div>
                    </div>
                    <span style="font-size:12px;font-weight:700;color:#16a34a"><%= Math.round(blockchainStats.signed_blocks/blockchainStats.total_blocks*100) %>%</span>
                </div>
            </div>
            <% } %>
            <% if (blockchainStats.last_block) { %>
            <div style="padding:10px 16px">
                <div style="font-size:11px;color:#9ca3af;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Khối mới nhất</div>
                <div style="display:flex;justify-content:space-between;margin-bottom:5px">
                    <span style="color:#6b7280;font-size:12px">Index</span>
                    <span style="font-weight:700;font-size:13px">#<%= blockchainStats.last_block.block_index %></span>
                </div>
                <div style="display:flex;justify-content:space-between;margin-bottom:5px">
                    <span style="color:#6b7280;font-size:12px">Nonce (PoW)</span>
                    <span style="font-weight:600;font-size:12px;color:#4f46e5"><%= (blockchainStats.last_block.nonce||0).toLocaleString() %></span>
                </div>
                <div style="display:flex;justify-content:space-between;margin-bottom:5px">
                    <span style="color:#6b7280;font-size:12px">Thời gian</span>
                    <span style="font-size:11px;color:#374151"><%= new Date(blockchainStats.last_block.timestamp).toLocaleString('vi-VN') %></span>
                </div>
                <div style="margin-top:6px">
                    <div style="font-size:11px;color:#9ca3af;margin-bottom:3px">Hash</div>
                    <code style="font-size:10px;color:#4f46e5;word-break:break-all"><%= blockchainStats.last_block.hash %></code>
                </div>
            </div>
            <% } %>
            <div style="padding:10px 16px;border-top:1px solid #f3f4f6;text-align:center">
                <a href="/blockchain" class="btn btn-outline btn-sm">Xem toàn bộ chuỗi →</a>
            </div>
        </div>
    </div>
</div>

<!-- Hàng 2: Biểu đồ tồn kho theo danh mục + Bảng gần đây -->
<div style="display:grid;grid-template-columns:1fr 2fr;gap:20px;margin-bottom:20px">

    <!-- Doughnut: tồn kho theo loại -->
    <div class="card">
        <div class="card-header">
            <h3>Tồn kho theo danh mục</h3>
        </div>
        <div class="card-body" style="display:flex;flex-direction:column;align-items:center;gap:16px">
            <canvas id="categoryChart" width="200" height="200" style="max-width:200px"></canvas>
            <div style="width:100%">
                <% categoryStock.forEach((c, i) => { %>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid #f9fafb;font-size:12px">
                    <span style="display:flex;align-items:center;gap:6px">
                        <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:var(--cat-<%= i %>)"></span>
                        <%= c.category %>
                    </span>
                    <strong><%= Number(c.total).toLocaleString() %></strong>
                </div>
                <% }) %>
            </div>
        </div>
    </div>

    <!-- Nhập/xuất gần đây -->
    <div style="display:flex;flex-direction:column;gap:20px">
        <div class="card">
            <div class="card-header">
                <h3>Nhập kho gần đây</h3>
                <a href="/imports" class="btn btn-outline btn-sm">Xem tất cả</a>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Người tạo</th><th>Thời gian</th></tr></thead>
                    <tbody>
                        <% if (recent_imports.length === 0) { %>
                        <tr><td colspan="4" class="empty-state">Chưa có dữ liệu</td></tr>
                        <% } %>
                        <% recent_imports.forEach(item => { %>
                        <tr>
                            <td><%= item.product_name %></td>
                            <td><span class="badge badge-green">+<%= item.quantity %></span></td>
                            <td><%= item.created_by_name %></td>
                            <td><%= new Date(item.created_at).toLocaleString('vi-VN') %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Xuất kho gần đây</h3>
                <a href="/exports" class="btn btn-outline btn-sm">Xem tất cả</a>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Người tạo</th><th>Thời gian</th></tr></thead>
                    <tbody>
                        <% if (recent_exports.length === 0) { %>
                        <tr><td colspan="4" class="empty-state">Chưa có dữ liệu</td></tr>
                        <% } %>
                        <% recent_exports.forEach(item => { %>
                        <tr>
                            <td><%= item.product_name %></td>
                            <td><span class="badge badge-red">-<%= item.quantity %></span></td>
                            <td><%= item.created_by_name %></td>
                            <td><%= new Date(item.created_at).toLocaleString('vi-VN') %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const trendLabels  = <%- JSON.stringify(chartLabels) %>;
const importData   = <%- JSON.stringify(chartImport) %>;
const exportData   = <%- JSON.stringify(chartExport) %>;
const catLabels    = <%- JSON.stringify(categoryStock.map(c => c.category)) %>;
const catData      = <%- JSON.stringify(categoryStock.map(c => Number(c.total))) %>;

const PALETTE = ['#4f46e5','#22c55e','#f59e0b','#ef4444','#0ea5e9','#a855f7','#f97316'];

// CSS vars for legend dots
catLabels.forEach((_, i) => {
    document.documentElement.style.setProperty('--cat-' + i, PALETTE[i % PALETTE.length]);
});

// Biểu đồ xu hướng (grouped bar)
new Chart(document.getElementById('trendChart'), {
    type: 'bar',
    data: {
        labels: trendLabels,
        datasets: [
            { label: 'Nhập kho', data: importData, backgroundColor: 'rgba(34,197,94,.75)', borderRadius: 4 },
            { label: 'Xuất kho', data: exportData, backgroundColor: 'rgba(239,68,68,.75)', borderRadius: 4 }
        ]
    },
    options: {
        responsive: true,
        plugins: { legend: { position: 'top', labels: { font: { size: 12 }, boxWidth: 12 } } },
        scales: {
            y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f3f4f6' } },
            x: { grid: { display: false } }
        }
    }
});

// Biểu đồ donut tồn kho
new Chart(document.getElementById('categoryChart'), {
    type: 'doughnut',
    data: {
        labels: catLabels,
        datasets: [{ data: catData, backgroundColor: PALETTE.slice(0, catData.length), borderWidth: 2, borderColor: '#fff' }]
    },
    options: {
        responsive: false,
        plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.raw.toLocaleString()}` } }
        },
        cutout: '62%'
    }
});
</script>

<%- include('partials/footer') %>
